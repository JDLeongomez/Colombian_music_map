# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local session settings (machine-specific permissions, not shared config)
.claude/settings.local.json

# Python (used for one-off asset regeneration scripts, e.g. map/relief data)
__pycache__/
*.pyc
.venv/
venv/

# Local environment files and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
tmp/
temp/

# Optional dependencies if tooling is added later
node_modules/
